#  EduNIC - Archivos a ignorar en Git

# ----- Sistema operativo -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Editores de código -----
# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ----- Logs y temporales -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.temp
*.bak
*.old

# ----- Dependencias (si algún día usan Node) -----
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ----- Builds y dist (si algún día usan bundler) -----
dist/
build/
out/
.cache/
.parcel-cache/

# ----- Variables de entorno y secretos -----
.env
.env.local
.env.*.local
*.key
*.pem
config.local.js

# ----- Archivos temporales del proyecto -----
# Notas personales, pruebas, etc.
NOTAS.md
TODO.md
pruebas/
test/
playground/

# ----- Backups -----
*.zip
*.rar
*.7z
backups/